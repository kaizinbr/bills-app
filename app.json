{
    "expo": {
        "name": "bills-app",
        "slug": "bills-app",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "billsapp",
        "userInterfaceStyle": "automatic",
        "ios": {
            "icon": "./assets/expo.icon"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "predictiveBackGestureEnabled": false,
            "package": "com.kaizinbr.billsapp"
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#208AEF",
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 76
                }
            ],
            "expo-secure-store",
            [
                "expo-font",
                {
                    "fonts": [
                        "node_modules/@expo-google-fonts/jersey-25/400Regular/Jersey25_400Regular.ttf"
                    ],
                    "android": {
                        "fonts": [
                            {
                                "fontFamily": "ana",
                                "fontDefinitions": [
                                    {
                                        "path": "./assets/fonts/ana-banana/AnaBanana-Hairline.otf",
                                        "weight": 100,
                                        "style": "normal"
                                    },
                                    {
                                        "path": "./assets/fonts/ana-banana/AnaBanana-Extralight.otf",
                                        "weight": 200,
                                        "style": "normal"
                                    },
                                    {
                                        "path": "./assets/fonts/ana-banana/AnaBanana-Light.otf",
                                        "weight": 300,
                                        "style": "normal"
                                    },
                                    {
                                        "path": "./assets/fonts/ana-banana/AnaBanana-Regular.otf",
                                        "weight": 400,
                                        "style": "normal"
                                    },
                                    {
                                        "path": "./assets/fonts/ana-banana/AnaBanana-Medium.otf",
                                        "weight": 500,
                                        "style": "normal"
                                    },
                                    {
                                        "path": "./assets/fonts/ana-banana/AnaBanana-SemiBold.otf",
                                        "weight": 600,
                                        "style": "normal"
                                    },
                                    {
                                        "path": "./assets/fonts/ana-banana/AnaBanana-Bold.otf",
                                        "weight": 700,
                                        "style": "normal"
                                    },
                                    {
                                        "path": "./assets/fonts/ana-banana/AnaBanana-Bold.otf",
                                        "weight": 800,
                                        "style": "normal"
                                    },
                                    {
                                        "path": "./assets/fonts/ana-banana/AnaBanana-Black.otf",
                                        "weight": 900,
                                        "style": "normal"
                                    }
                                ]
                            }
                        ]
                    }
                }
            ],
            "expo-image"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "ddb34a58-6cc3-4852-9db5-92ebb890fb04"
            }
        },
        "owner": "kaizinbr"
    }
}
